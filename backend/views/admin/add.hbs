<div class="container" style="margin:100px auto">
  <div class="row">
    <div class="col-6 offset-3">
      <h4>Add another new</h4>
      <form action="/admin/news/add" method="post" enctype="multipart/form-data">
        <div class="form-group mb-3">
          <input
            type="text"
            name="title"
            class="form-control"
            placeholder="Title"
          />
        </div>
        <div class="form-group mb-3">
          <input
            type="text"
            name="subtitle"
            class="form-control"
            placeholder="Subtitle"
          />
        </div>
        <div class="form-group mb-3">
          <input
            type="file"
            name="image"
            id="image"
            class="form-control mb-3"
          />
        </div>
        <div class="form-group mb-3">
          <textarea
            type="text"
            name="body"
            class="form-control"
            placeholder="Body"
          ></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
      </form>
      {{#if error}}
        <p>{{message}}</p>
      {{/if}}
    </div>
  </div>
</div>