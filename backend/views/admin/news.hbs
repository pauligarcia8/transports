<div class="container mt-5">
  <div class="row mb-4">
    <div class="col text-end">
      <p class="mb-0">
        Welcome, {{user}}
        <a class="btn btn-danger ms-2" href="/admin/login/logout">
          Log Out <i class="fas fa-sign-out-alt"></i>
        </a>
      </p>
    </div>
  </div>
  <div class="row align-items-center mb-4">
    <div class="col-10">
      <h3 class="mb-0">News List</h3>
    </div>
    <div class="col-2 text-end">
      <a class="btn btn-success" href="/admin/news/add">
        <i class="fa fa-plus" aria-hidden="true"></i> New
      </a>
    </div>
  </div>
  <div class="row">
    <div class="col">
      <table class="table table-bordered table-hover">
        <thead class="table-dark">
          <tr>
            <th scope="col" style="width: 5%;">#</th>
            <th scope="col" style="width: 75%;">Title</th>
            <th scope="col" class="text-end" style="width: 20%;">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each news}}
            <tr>
                <th scope="row">{{id}}</th>
                <td>{{title}}</td>
                <td class="text-end">
                    <a href="/admin/news/edit/{{id}}" class="btn btn-sm btn-secondary me-2">
                    <i class="fa fa-pencil"></i>
                    </a>
                    <a href="/admin/news/delete/{{id}}" class="btn btn-sm btn-danger">
                    <i class="fa fa-trash"></i>
                    </a>
                </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>
